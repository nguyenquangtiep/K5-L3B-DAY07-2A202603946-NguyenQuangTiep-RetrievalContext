# Mẫu cấu hình Day 7. Copy thành .env rồi điền giá trị thật. KHÔNG commit .env.

# --- Vector store Day 6 (PostgreSQL + pgvector chạy bằng Docker, chỉ local) ---
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
VECTOR_STRATEGY=B

# --- Embedding: phải trùng model đã dùng để index ở Day 6 ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- LLM cho agent ---
# Cấu hình đã dùng cho benchmark: Gemini (Google AI Studio, free tier).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

# Hoặc OpenRouter: LLM_PROVIDER=openrouter, LLM_MODEL=<id model>, OPENROUTER_API_KEY=...
OPENROUTER_API_KEY=
# Đặt =1 nếu cố ý dùng model OpenRouter trả phí (không có đuôi :free); mặc định code chặn.
ALLOW_PAID_MODEL=
